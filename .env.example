# Copy this file to .env and fill in your own values.
# Never commit the real .env file — it is already in .gitignore.

# --- Dashboard login (HTTP Basic Auth) ---
APP_USERNAME=
APP_PASSWORD=

# --- Company details shown on invoices ---
COMPANY_NAME=
COMPANY_ADDRESS=
COMPANY_EMAIL=
COMPANY_PHONE=
COMPANY_VAT=
COMPANY_LOGO_PATH=

# --- Gmail SMTP (use a Gmail App Password, not your real password) ---
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=
GMAIL_FROM_NAME=

# --- Google Drive / Sheets (requires credentials.json + first-run OAuth consent) ---
GOOGLE_DRIVE_FOLDER_ID=
GOOGLE_SHEETS_ID=
GOOGLE_SHEETS_TAB_NAME=Invoices
